    "fapi_request_method": {
      "notApplicableWhen": {
        "fapi_profile": {
          "fapi_client_credentials_grant": [
            "unsigned",
            "signed_non_repudiation"
          ],
          "consumerdataright_au": [
            "unsigned"
          ]
        }
      },
      "variantInfo": {
        "description": "The method to use to pass the request to the authorization server's pushed request object endpoint. If unsure, pick 'unsigned' - the default method in FAPI2 Baseline. Some ecosystems may require the use of FAPI1Advanced compatible signed request objects - in that case, select 'signed non repudiation'.",
        "displayName": "Request Method"
      },
      "variantValues": {
        "unsigned": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        },
        "signed_non_repudiation": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        }
      }
    },
    "fapi_response_mode": {
      "notApplicableWhen": {
        "fapi_profile": {
          "fapi_client_credentials_grant": [
            "plain_response",
            "jarm"
          ],
          "vci_haip": [
            "plain_response",
            "jarm"
          ],
          "consumerdataright_au": [
            "plain_response"
          ],
          "vci": [
            "plain_response",
            "jarm"
          ]
        }
      },
      "variantInfo": {
        "description": "The response mode that will be used. 'Plain response' is the most commonly used. JARM (JWT Secured Authorization Response Mode) is an option in the FAPI specifications. If in doubt, select 'plain_response'.",
        "displayName": "FAPI Response Mode"
      },
      "variantValues": {
        "plain_response": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        },
        "jarm": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        }
      }
    },
    "grant_management": {
      "notApplicableWhen": {
        "fapi_profile": {
          "openbanking_chile": [
            "disabled"
          ],
          "fapi_client_credentials_grant": [
            "enabled"
          ],
          "openbanking_brazil": [
            "enabled"
          ],
          "connectid_au": [
            "enabled"
          ],
          "vci_haip": [
            "enabled"
          ],
          "ksa": [
            "enabled"
          ],
          "consumerdataright_au": [
            "enabled"
          ],
          "cbuae": [
            "enabled"
          ],
          "vci": [
            "enabled"
          ]
        }
      },
      "variantInfo": {
        "description": "Whether Grant Management (https://openid.net/specs/oauth-v2-grant-management.html) support is required. When enabled, every authorization request includes grant_management_action=create and the token response is validated to contain a grant_id.",
        "displayName": "Grant Management"
      },
      "variantValues": {
        "disabled": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        },
        "enabled": {
          "configurationFields": [],
          "hidesConfigurationFields": []
        }
      }
    },
