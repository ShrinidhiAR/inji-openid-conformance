          ],
          "cbuae": [
            "client_attestation"
          ]
        }
      },
      "variantInfo": {
        "description": "The type of client authentication your software supports. If you support multiple types of client authentication test each one, one at a time.",
        "displayName": "Client Authentication Type"
      },
      "variantValues": {
        "private_key_jwt": {
